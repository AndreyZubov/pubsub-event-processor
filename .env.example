# Copy to .env and fill in real values. .env is gitignored.

# --- Salesforce OAuth ---
# External Client App credentials for the client-credentials flow
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_LOGIN_URL=https://login.salesforce.com

# --- Subscription ---
# Comma-separated list of Pub/Sub topics (Platform Events or CDC channels)
# Example: /event/Order_Event__e,/data/AccountChangeEvent
SF_TOPICS=/event/Order_Event__e
PUBSUB_ENDPOINT=api.pubsub.salesforce.com:7443
# Optional PEM bundle to trust instead of the system roots (TLS-inspecting
# proxy, or the local fake org started by `make demo`).
# PUBSUB_CA_FILE=

# --- Storage ---
DATABASE_URL=postgres://postgres:postgres@localhost:5433/pubsub?sslmode=disable
DATABASE_MAX_CONNS=20

# --- Kafka sink (optional) ---
# Forwards every persisted event to a Kafka topic.
KAFKA_ENABLED=false
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC=salesforce.events

# --- Deduplication cache (optional) ---
# Skips the database write for events already processed in full.
REDIS_ENABLED=false
# REDIS_ADDR=localhost:6379

# --- Runtime tuning ---
WORKER_COUNT=8
FLOW_BATCH_SIZE=100

# --- Admin HTTP server ---
HTTP_ADDR=:8080

# --- Logging ---
# Levels: debug, info, warn, error
LOG_LEVEL=info
